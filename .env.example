# KTAS Tools Environment Configuration

# Server Port (default: 5000)
PORT=5000

# Environment Mode
NODE_ENV=production

# Session Security (Generate a random string for production)
SESSION_SECRET=your-random-32-character-secret-key-here

# Log Level: info, debug, warn, error
LOG_LEVEL=info

# Optional Admin Email (if you want to restrict the /admin panel)
ADMIN_EMAIL=admin@yourdomain.com

# Optional Clerk Authentication (leave blank to run in standalone local mode)
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
