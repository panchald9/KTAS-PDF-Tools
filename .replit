modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "workbook-browser"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "workbook-browser-types"

[[workflows.workflow]]
name = "workbook-browser"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm test:workbook-browser"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "workbook-browser-types"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm typecheck:workbook-browser"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["dejavu_fonts", "freetype", "ghostscript", "gumbo", "harfbuzz", "jbig2dec", "lcms2", "libimagequant", "libjpeg", "libjpeg_turbo", "libreoffice", "libtiff", "libwebp", "libxcrypt", "mupdf", "openjpeg", "pkg-config", "swig", "tcl", "tesseract", "tk", "xcbuild", "zlib"]

[userenv]

[userenv.shared]
ADMIN_EMAIL = "tarunwork2131@gmail.com"
