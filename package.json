{
  "name": "ktas-tools",
  "version": "1.0.0",
  "description": "KTAS Tools - Free PDF, Word, Excel, Image and Text Toolkit (Fullstack Node.js)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"blue,green\" \"tsx watch server/index.ts\" \"vite --config client/vite.config.ts client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --config client/vite.config.ts client",
    "build": "npm run build:client",
    "build:client": "vite build --config client/vite.config.ts client",
    "start": "tsx server/index.ts",
    "preview": "vite preview --config client/vite.config.ts client"
  },
